# Copie para .env e preencha (o .env fica fora do Git).
# Usado pelo backend (spring.config.import) e pelo banco:
#   docker compose --env-file backend-financas/.env up -d   (rodar na raiz do repositório)

# Segredo do JWT — UMA linha só. Gere com: openssl rand -base64 64 | tr -d '\n'
JWT_SECRET=

# Credenciais do PostgreSQL (usuário criado na primeira subida do volume)
DB_USER=
DB_PASSWORD=
